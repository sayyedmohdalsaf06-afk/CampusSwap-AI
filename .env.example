# ---------------------------------------------------------------------------
# Client-side config (safe to expose — inlined into the app bundle).
# Copy this file to `.env` and fill in your local/project values.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development

# Demo-mode only (EXPO_PUBLIC_APP_ENV=demo) — throwaway demo account creds; not used in production
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Server / Edge Function secrets (NEVER commit, never EXPO_PUBLIC):
#   SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, RESEND_API_KEY,
#   RESEND_FROM_EMAIL, POSTHOG_KEY
# These are configured as Supabase Edge Function secrets, not in this file.
# ---------------------------------------------------------------------------
